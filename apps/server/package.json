{
  "name": "@acs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "NODE_NO_WARNINGS=1 node dist/index.js",
    "test": "NODE_NO_WARNINGS=1 vitest run"
  },
  "dependencies": {
    "@acs/astro": "workspace:*",
    "@fastify/cors": "11.4.2",
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
